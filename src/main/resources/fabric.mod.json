{
  "schemaVersion": 1,
  "id": "shop_mod_lyn",
  "version": "${version}",
  "name": "SHOP-MOD-lyn",
  "description": "Survival shop and player auction house with buy-now listings, bidding, and ECO-API-lyn integration. Required on server and clients.",
  "authors": [
    "lyn"
  ],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "shop-mod-lyn.accesswidener",
  "entrypoints": {
    "main": [
      "dev.lyn.shop.network.ShopNetworking"
    ],
    "server": [
      "dev.lyn.shop.ShopServer"
    ],
    "client": [
      "dev.lyn.shop.client.ShopClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25"
  },
  "suggests": {
    "eco_api_lyn": ">=1.2.0"
  }
}
